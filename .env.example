# Anthropic (default provider)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Groq (free tier — use with --provider groq)
# Get your free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Azure OpenAI (use with --provider azure)
AZURE_OPENAI_API_KEY=your_azure_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o          # your deployment name
AZURE_OPENAI_API_VERSION=2024-02-01     # optional, this is the default

# Optional: increases GitHub API rate limit from 60 to 5000 req/hr
GITHUB_TOKEN=your_github_token_here
